<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- The name in the Mac menu bar and wherever the system names the app (the target is still called SapientChat). -->
	<key>CFBundleName</key>
	<string>Sapient Studio</string>
	<key>BGTaskSchedulerPermittedIdentifiers</key>
	<array>
		<string>$(PRODUCT_BUNDLE_IDENTIFIER).download.*</string>
	</array>
	<!-- The launch screen is the splash's background colour, so the animated SplashView picks up seamlessly. -->
	<key>UILaunchScreen</key>
	<dict>
		<key>UIColorName</key>
		<string>LaunchBackground</string>
	</dict>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>so.openhorizon.sapient.studio.api</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>sapient</string>
			</array>
		</dict>
	</array>
	<key>NSBonjourServices</key>
	<array>
		<string>_http._tcp</string>
	</array>
</dict>
</plist>
